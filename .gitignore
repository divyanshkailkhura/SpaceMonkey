# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# load test results (except the 3 baseline refs)
load-tests/results/*
!load-tests/results/posts-prod.json
!load-tests/results/posts-scenario-a.json
!load-tests/results/posts-scenario-b.json

# raw seed data (73MB SQL dump)
data-seed/

# skills
/.claude/
/.agents/
/.windsurf/
skills-lock.json
